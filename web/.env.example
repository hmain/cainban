# cainban connect-page SPA configuration.
#
# Copy to `.env` for local dev, or set these as Amplify Hosting environment
# variables for a deployed build. ALL values come from the CDK stack outputs
# (see web/README.md). None is a secret — a public PKCE SPA client has no
# client secret, which is expected.

# Cognito user pool id (stack output UserPoolId), e.g. eu-north-1_knwIJmOs6
VITE_USER_POOL_ID=eu-north-1_knwIJmOs6

# SPA app client id (stack output SpaClientId) — public, PKCE, no secret.
VITE_USER_POOL_CLIENT_ID=REPLACE_WITH_SpaClientId

# Cognito Hosted UI domain WITHOUT scheme (derived from stack output
# HostedUiDomain by stripping https://), e.g.:
#   cainban-emawiant-528757808822.auth.eu-north-1.amazoncognito.com
VITE_COGNITO_DOMAIN=REPLACE_WITH_HostedUiDomain_without_https

# Connect API base URL (stack output ConnectApiUrl)
VITE_CONNECT_API=https://64f3ievzmf.execute-api.eu-north-1.amazonaws.com/

# MCP API base URL (stack output McpApiUrl) — shown in the copy-paste config
VITE_MCP_API=https://cl4qelp4hf.execute-api.eu-north-1.amazonaws.com/

# Optional: the redirect URL registered as a SPA client callback. Defaults to
# window.location.origin + "/" when unset. For local dev: http://localhost:5173/
# For a deployed build: your Amplify app URL (register it as a SPA callback via
# CDK context -c spaCallbackUrls=... and redeploy).
# VITE_REDIRECT_URL=http://localhost:5173/

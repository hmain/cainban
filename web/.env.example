# cainban connect-page SPA configuration.
#
# Copy to `.env` for local dev, or set as an Amplify Hosting environment
# variable for a deployed build. GitHub-only auth: the SPA runs the GitHub
# device flow entirely against the MCP API, so there is NO Cognito/Amplify
# configuration and no secret here.

# MCP API base URL (stack output McpApiUrl). The connect page POSTs the device
# flow to <VITE_MCP_API>/auth/github/device and shows the resulting MCP config.
VITE_MCP_API=https://cl4qelp4hf.execute-api.eu-north-1.amazonaws.com/
